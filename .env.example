# Copy this file to `.env` (gitignored) and fill in your values.
# Chaturbate account used to authenticate all API calls.
CHATURBATE_USERNAME=

# Token authorizing the room-stats API and the affiliate-earnings API.
# The SAME token works for both. Created on https://chaturbate.com/statsapi/authtoken/
# (Stats API scope). Shown as: https://chaturbate.com/statsapi/?username=<you>&token=<token>
CHATURBATE_STATS_TOKEN=

# Events-scope token for the live events long-poll feed.
# Shown on the authtoken page as: https://eventsapi.chaturbate.com/events/<you>/<token>/
# A "private" scope exposes tips + private messages; a "public" scope omits them.
CHATURBATE_EVENTS_TOKEN=
